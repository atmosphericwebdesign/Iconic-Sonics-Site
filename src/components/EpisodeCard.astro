---
const { ep } = Astro.props;
const meta = ['Full Episode', ep.durationText].filter(Boolean).join(' · ');
const sub = [ep.guestText, ep.numberText].filter(Boolean).join(' · ');
const search = [ep.title, ...ep.guests, ...ep.topics].join(' ').toLowerCase();
---
<article class="ep-card" data-guests={ep.guests.join('|')} data-topics={ep.topics.join('|')} data-era={ep.era || ''} data-search={search} style="display: grid; grid-template-columns: 104px minmax(0,1fr); grid-template-rows: auto auto; column-gap: 16px; row-gap: 14px; align-items: center; padding: 14px; background: rgba(110,110,110,.10); border: 1px solid rgba(20,35,28,.10); border-radius: 16px">
<a href={ep.href} aria-label={`Watch ${ep.title}`} class="ph-dark" style="width: 104px; height: 104px; border-radius: 10px; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden">{ep.thumb && <img src={ep.thumb} alt="" loading="lazy" width="400" height="400" style={`position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: ${ep.thumbPosition}`}>}<span style="position: absolute; left: 6px; bottom: 6px; width: 26px; height: 26px; border-radius: 50%; background: rgba(247,244,236,.92); color: #0F3A2B; display: flex; align-items: center; justify-content: center"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"></path></svg></span></a>
<div style="min-width: 0">
<p style="margin: 0 0 4px; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #185640">{meta}</p>
<h3 style="margin: 0 0 4px; font-family: Gobold, Impact, 'Arial Narrow', sans-serif; font-size: 22px; font-weight: 700; line-height: 1.15"><a href={ep.href} class="hl">{ep.title}</a></h3>
{sub && <p style="margin: 0; font-size: 13px; color: #4A5A52">{sub}</p>}
</div>
<div style="grid-column: 1 / -1; display: flex; flex-wrap: nowrap; gap: 8px">
<a href={ep.links.youtube} class="btn-gold" style="flex: 1 1 0; display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 36px; padding: 0 10px; background: #FFB71B; color: #14231C; text-decoration: none; font-weight: 700; font-size: 12.5px; border-radius: 999px; white-space: nowrap"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"></path></svg>YouTube</a>
<a href={ep.links.spotify} class="btn-line" style="flex: 1 1 0; display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 36px; padding: 0 10px; border: 1.5px solid rgba(20,35,28,.45); color: #14231C; text-decoration: none; font-weight: 600; font-size: 12.5px; border-radius: 999px; box-sizing: border-box; white-space: nowrap"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3zM3 19a2 2 0 0 0 2 2h1v-6H3z"></path></svg>Spotify</a>
<a href={ep.links.apple} class="btn-line" style="flex: 1 1 0; display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 36px; padding: 0 10px; border: 1.5px solid rgba(20,35,28,.45); color: #14231C; text-decoration: none; font-weight: 600; font-size: 12.5px; border-radius: 999px; box-sizing: border-box; white-space: nowrap"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3zM3 19a2 2 0 0 0 2 2h1v-6H3z"></path></svg>Apple</a>
</div>
</article>
