---
const { video } = Astro.props;
---
<!-- Featured video -->
<section aria-labelledby="vid-feat-h">
<div class="wrap pg-body" style="max-width: 1280px; margin: 0 auto; padding: 0 24px 48px; box-sizing: border-box">
<div class="vid-feature" style="display: flex; gap: 40px; align-items: center">
<a href={video.url} aria-label={`Play ${video.title}`} class="ph-dark" style="flex: 3 1 0; min-width: 0; display: flex; aspect-ratio: 16 / 9; align-items: center; justify-content: center; position: relative; border-radius: 6px; width: 100%">{video.thumb && <img src={video.thumb} alt="" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 6px">}<span style="position: relative; width: 84px; height: 84px; border-radius: 50%; background: #FFB71B; color: #14231C; display: flex; align-items: center; justify-content: center"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"></path></svg></span></a>
<div style="flex: 2 1 0; min-width: 0; display: flex; flex-direction: column; gap: 14px">
<p style="margin: 0; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #185640">{['Featured', video.kind === 'Full episode' ? 'Full episode' : video.kind, video.runtime].filter(Boolean).join(' · ')}</p>
<h2 id="vid-feat-h" style="margin: 0; font-family: Gobold, Impact, 'Arial Narrow', sans-serif; font-size: 40px; font-weight: 700; line-height: 1.08; color: #0F3A2B"><a href={video.url} class="hl">{video.title}</a></h2>
{video.summary && <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #3E4F47">{video.summary}</p>}
<a href={video.url} class="btn-gold" style="align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; height: 48px; padding: 0 22px; background: #FFB71B; color: #14231C; text-decoration: none; font-weight: 700; font-size: 15px; border-radius: 999px"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"></path></svg>Watch on YouTube</a>
</div>
</div>
</div>
</section>

