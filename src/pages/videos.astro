---
import Base from '../layouts/Base.astro';
import VideoCard from '../components/VideoCard.astro';
import FeaturedVideo from '../components/FeaturedVideo.astro';
import Join from '../components/Join.astro';
import { videos, site } from '../lib/content.js';
import '../styles/videos.css';
const featuredVideo = videos.find((v) => v.kind === 'Full episode') || videos[0];
const gridVideos = videos.length ? videos.filter((v) => v !== featuredVideo) : site.showPlaceholders ? Array(8).fill(null) : [];
const FEATURED_PLACEHOLDER = site.showPlaceholders ? '<!-- Featured video -->\n<section aria-labelledby="vid-feat-h">\n<div class="wrap pg-body" style="max-width: 1280px; margin: 0 auto; padding: 0 24px 48px; box-sizing: border-box">\n<div class="vid-feature" style="display: flex; gap: 40px; align-items: center">\n<a href="#" aria-label="Play featured video" class="ph-dark" style="flex: 3 1 0; min-width: 0; display: flex; aspect-ratio: 16 / 9; align-items: center; justify-content: center; position: relative; border-radius: 6px; width: 100%"><span style="position: absolute; left: 16px; top: 14px; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: rgba(244,238,223,.7)">[Featured video]</span><span style="width: 84px; height: 84px; border-radius: 50%; background: #FFB71B; color: #14231C; display: flex; align-items: center; justify-content: center"><svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"></path></svg></span></a>\n<div style="flex: 2 1 0; min-width: 0; display: flex; flex-direction: column; gap: 14px">\n<p style="margin: 0; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #185640">Featured · [Runtime]</p>\n<h2 id="vid-feat-h" style="margin: 0; font-family: Gobold, Impact, \'Arial Narrow\', sans-serif; font-size: 40px; font-weight: 700; line-height: 1.08; color: #0F3A2B"><a href="#" class="hl">[Featured video title]</a></h2>\n<p style="margin: 0; font-size: 16px; line-height: 1.6; color: #3E4F47">[One or two sentences on what happens in this video and who is in it.]</p>\n<a href="#" class="btn-gold" style="align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; height: 48px; padding: 0 22px; background: #FFB71B; color: #14231C; text-decoration: none; font-weight: 700; font-size: 15px; border-radius: 999px"><svg width="11" height="11" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"></path></svg>Watch on YouTube</a>\n</div>\n</div>\n</div>\n</section>\n\n' : '';
---
<Base title="Videos" description="Full episodes, clips and shorts from the Iconic Sonics studio." current="videos">
<!-- Page header -->
<section aria-labelledby="pg-h">
<div class="wrap pg-head" style="max-width: 1280px; margin: 0 auto; padding: 64px 24px 32px; box-sizing: border-box">
<nav aria-label="Breadcrumb" style="font-size: 13px; margin-bottom: 24px; display: flex; gap: 8px; color: #4A5A52"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Videos</span></nav>
<p style="margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #185640">Watch</p>
<h1 id="pg-h" class="pg-h1" style="margin: 0 0 14px; font-family: Gobold, Impact, 'Arial Narrow', sans-serif; font-size: 76px; font-weight: 700; line-height: 1.02; color: #0F3A2B">Videos</h1>
<p class="pg-intro" style="margin: 0; font-size: 20px; line-height: 1.55; color: #3E4F47; max-width: 640px">Full episodes, clips and shorts from the Iconic Sonics studio.</p>
</div>
</section>

{featuredVideo ? <FeaturedVideo video={featuredVideo} /> : <Fragment set:html={FEATURED_PLACEHOLDER} />}

<!-- Video grid -->
<section aria-label="All videos">
<div class="wrap pg-body" style="max-width: 1280px; margin: 0 auto; padding: 0 24px 96px; box-sizing: border-box">
<div class="sec-head" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 32px; padding-bottom: 16px; border-bottom: 1px solid rgba(20,35,28,.2)">
<nav aria-label="Filter videos" class="chip-row" data-chip-filter="data-kind" data-target="#vid-grid > article" style="display: flex; flex-wrap: wrap; gap: 8px">{["All","Full episode","Clip","Short"].map((k, i) => <a href="#" class={i === 0 ? "chip chip-on" : "chip"} aria-current={i === 0 ? "true" : undefined} data-value={i === 0 ? "" : k}>{i === 0 ? "All" : k + "s"}</a>)}</nav>
</div>
<div id="vid-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 36px 24px">
{gridVideos.map((v) => <VideoCard video={v} />)}
</div>

</div>
</section>

<Join />

<script is:inline>
(function () {
  var nav = document.querySelector('[data-chip-filter]'); if (!nav) return;
  var attr = nav.getAttribute('data-chip-filter'), items = [].slice.call(document.querySelectorAll(nav.getAttribute('data-target')));
  var count = document.getElementById('chip-count');
  nav.addEventListener('click', function (e) {
    var a = e.target.closest('a'); if (!a) return; e.preventDefault();
    nav.querySelectorAll('a').forEach(function (x) { var on = x === a; x.classList.toggle('chip-on', on); x.toggleAttribute('aria-current', on); if (x.dataset.onStyle) x.setAttribute('style', on ? x.dataset.onStyle : x.dataset.offStyle); });
    var v = a.dataset.value, n = 0;
    items.forEach(function (it) { var ok = !v || it.getAttribute(attr) === v; it.hidden = !ok; if (ok) n++; });
    
  });
})();
</script>
</Base>
