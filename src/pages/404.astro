---
import Base from '../layouts/Base.astro';
import '../styles/episodes.css';
---
<Base title="Page not found" description="That page is not here.">
<section aria-labelledby="pg-h">
<div class="wrap pg-head" style="max-width: 1280px; margin: 0 auto; padding: 96px 24px 120px; box-sizing: border-box">
<p style="margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #185640">404</p>
<h1 id="pg-h" class="pg-h1" style="margin: 0 0 14px; font-family: Gobold, Impact, 'Arial Narrow', sans-serif; font-size: 76px; font-weight: 700; line-height: 1.02; color: #0F3A2B">Air ball.</h1>
<p class="pg-intro" style="margin: 0 0 28px; font-size: 20px; line-height: 1.55; color: #3E4F47; max-width: 640px">That page doesn't exist. Try the latest episodes instead.</p>
<a href="/episodes/" class="btn-gold" style="display: inline-flex; align-items: center; height: 52px; padding: 0 26px; background: #FFB71B; color: #14231C; text-decoration: none; font-weight: 800; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; border-radius: 2px">See all episodes</a>
</div>
</section>
</Base>
