<div style="display: flex; justify-content: center; margin-top: 48px"><button type="button" class="btn-line" style="height: 52px; padding: 0 28px; border: 1.5px solid rgba(20,35,28,.45); background: transparent; color: #14231C; font-family: Poppins, system-ui, sans-serif; font-weight: 700; font-size: 15px; border-radius: 999px; cursor: pointer">Load more stories</button></div>
</div>
</section>

