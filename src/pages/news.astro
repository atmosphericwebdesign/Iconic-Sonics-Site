---
import Base from '../layouts/Base.astro';
import Join from '../components/Join.astro';
import '../styles/news.css';
---
<Base title="Sonics News" description="The latest on the push to bring the Sonics back to Seattle, plus original stories from the team's history." current="news">
<!-- Page header -->
<section aria-labelledby="pg-h">
<div class="wrap pg-head" style="max-width: 1280px; margin: 0 auto; padding: 64px 24px 32px; box-sizing: border-box">
<nav aria-label="Breadcrumb" style="font-size: 13px; margin-bottom: 24px; display: flex; gap: 8px; color: #4A5A52"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Sonics News</span></nav>
<p style="margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #185640">Reporting and stories</p>
<h1 id="pg-h" class="pg-h1" style="margin: 0 0 14px; font-family: Gobold, Impact, 'Arial Narrow', sans-serif; font-size: 76px; font-weight: 700; line-height: 1.02; color: #0F3A2B">Sonics News</h1>
<p class="pg-intro" style="margin: 0; font-size: 20px; line-height: 1.55; color: #3E4F47; max-width: 640px">The latest on the push to bring the Sonics back, plus original stories from the team&rsquo;s history.</p>
</div>
</section>

<!-- Lead story -->
<section aria-labelledby="news-lead-h">
<div class="wrap pg-body" style="max-width: 1280px; margin: 0 auto; padding: 0 24px 40px; box-sizing: border-box">
<article class="news-lead" style="display: flex; gap: 40px; align-items: center; padding-bottom: 40px; border-bottom: 1px solid rgba(20,35,28,.2)">
<a href="#" aria-label="Read lead story" class="ph-dark" style="flex: 3 1 0; min-width: 0; width: 100%; display: block; aspect-ratio: 16 / 10; border-radius: 6px; position: relative"><span style="position: absolute; left: 16px; bottom: 14px; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: rgba(244,238,223,.7)">[Lead story image]</span></a>
<div style="flex: 2 1 0; min-width: 0; display: flex; flex-direction: column; gap: 14px">
<p style="margin: 0; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #185640">News · Expansion</p>
<h2 id="news-lead-h" style="margin: 0; font-family: Gobold, Impact, 'Arial Narrow', sans-serif; font-size: 44px; font-weight: 700; line-height: 1.06; color: #0F3A2B"><a href="#" class="hl">[Lead news headline]</a></h2>
<p style="margin: 0; font-size: 17px; line-height: 1.6; color: #3E4F47">[Two sentence summary of the most important Sonics news this week.]</p>
<p style="margin: 0; font-size: 13px; color: #4A5A52">By [Author] · [Date]</p>
</div>
</article>
</div>
</section>

<!-- Story list -->
<section aria-label="All news and stories">
<div class="wrap pg-body" style="max-width: 1080px; margin: 0 auto; padding: 0 24px 96px; box-sizing: border-box">
<div style="margin-bottom: 8px"><nav aria-label="Filter news" class="chip-row" style="display: flex; flex-wrap: wrap; gap: 8px"><a href="#" class="chip chip-on" aria-current="true">All</a><a href="#" class="chip">News</a><a href="#" class="chip">Stories</a><a href="#" class="chip">Expansion</a></nav></div>
<article class="news-row" style="display: grid; grid-template-columns: 220px minmax(0,1fr); gap: 28px; align-items: center; padding: 28px 0; border-bottom: 1px solid rgba(20,35,28,.14)">
<a href="#" aria-label="Read story" class="ph" style="display: block; aspect-ratio: 3 / 2; border-radius: 3px; position: relative"><span style="position: absolute; left: 10px; bottom: 8px; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; color: #4A5A52">[Image]</span></a>
<div style="min-width: 0">
<p style="margin: 0 0 8px; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #185640">News</p>
<h3 style="margin: 0 0 8px; font-family: Gobold, Impact, 'Arial Narrow', sans-serif; font-size: 28px; font-weight: 600; line-height: 1.2"><a href="#" class="hl">[Sonics news headline]</a></h3>
<p style="margin: 0 0 10px; font-size: 15px; line-height: 1.6; color: #3E4F47">[One sentence summary of the news.]</p>
<p style="margin: 0; font-size: 13px; color: #4A5A52">By [Author] · [Date]</p>
</div>
</article>
