---
import Base from '../layouts/Base.astro';
import Join from '../components/Join.astro';
import { partners, site } from '../lib/content.js';
import '../styles/partners.css';
const contact = site.partnerEmail ? `mailto:${site.partnerEmail}?subject=Partnering with Iconic Sonics` : '#';
---
<Base title="Partners" description="Meet the local businesses that make Iconic Sonics possible, and learn how to partner with the show." current="partners">
<!-- Page header -->
<section aria-labelledby="pg-h">
<div class="wrap pg-head" style="max-width: 1280px; margin: 0 auto; padding: 64px 24px 32px; box-sizing: border-box">
<nav aria-label="Breadcrumb" style="font-size: 13px; margin-bottom: 24px; display: flex; gap: 8px; color: #4A5A52"><a href="/">Home</a><span aria-hidden="true">/</span><span aria-current="page">Partners</span></nav>
<p style="margin: 0 0 12px; font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: #185640">Our partners</p>
<h1 id="pg-h" class="pg-h1" style="margin: 0 0 14px; font-family: Gobold, Impact, 'Arial Narrow', sans-serif; font-size: 76px; font-weight: 700; line-height: 1.02; color: #0F3A2B">Partners</h1>
<p class="pg-intro" style="margin: 0; font-size: 20px; line-height: 1.55; color: #3E4F47; max-width: 640px">Iconic Sonics is made possible by local businesses who love this city and this team. Here is how each one got involved.</p>
</div>
</section>

<!-- Partner stories -->
<section aria-label="Partner stories">
<div class="wrap pg-body" style="max-width: 1180px; margin: 0 auto; padding: 8px 24px 88px; box-sizing: border-box; display: flex; flex-direction: column; gap: 28px">
{partners.map((p) => (
<article id={p.id} class="partner" aria-labelledby={`${p.id}-h`} style="display: flex; gap: 48px; align-items: center; padding: 40px; background: #FFFFFF; border: 1px solid rgba(20,35,28,.12); border-radius: 16px; scroll-margin-top: 24px">
<div class="partner-logo" style="flex: 0 0 360px; height: 220px; display: flex; align-items: center; justify-content: center; background: #F7F4EC; border-radius: 10px">{p.logo ? <img src={p.logo} alt={`${p.name} logo`} loading="lazy" style={`display: block; width: ${p.logoWidth}px; max-width: 75%; max-height: 170px; height: auto; object-fit: contain`}> : <span style="font-family: Gobold, Impact, 'Arial Narrow', sans-serif; font-size: 40px; letter-spacing: .03em; text-transform: uppercase; color: #0F3A2B">{p.name}</span>}</div>
<div style="flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; gap: 14px">
<p style="margin: 0; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #185640">{[`Partner since ${p.since}`, p.type].filter(Boolean).join(" · ")}</p>
<h2 id={`${p.id}-h`} style="margin: 0; font-family: Gobold, Impact, 'Arial Narrow', sans-serif; font-size: 44px; font-weight: 700; line-height: 1.05; color: #0F3A2B">{p.name}</h2>
<p style="margin: 0; font-size: 17px; line-height: 1.65; color: #3E4F47">{p.story}</p>
<a href={p.url} style="align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-weight: 600; font-size: 17px">Visit {p.name}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
</div>
</article>
))}
</div>
</section>

<!-- Become a partner -->
<section id="become" aria-labelledby="become-h" style="background: #0F3A2B; color: #F4EEDF; scroll-margin-top: 24px">
<div class="wrap become" style="max-width: 1080px; margin: 0 auto; padding: 88px 24px; box-sizing: border-box; text-align: center; display: flex; flex-direction: column; align-items: center; gap: 18px">
<h2 id="become-h" style="margin: 0; font-family: Gobold, Impact, 'Arial Narrow', sans-serif; font-size: 60px; font-weight: 700; line-height: 1.05; color: #FFB71B">Partner with Iconic Sonics</h2>
<p style="margin: 0; font-size: 18px; line-height: 1.6; color: rgba(244,238,223,.85); max-width: 600px">Put your business in front of Seattle&rsquo;s most loyal fans, across episodes, events and the community, and help bring the Sonics home.</p>
<a href={contact} class="btn-gold" style="margin-top: 8px; display: inline-flex; align-items: center; height: 56px; padding: 0 30px; background: #FFB71B; color: #14231C; text-decoration: none; font-weight: 800; font-size: 15px; letter-spacing: .06em; text-transform: uppercase; border-radius: 2px">Get in touch</a>
{site.partnerEmail ? <p style="margin: 0; font-size: 14px; color: rgba(244,238,223,.7)">{site.partnerEmail}</p> : site.showPlaceholders && <p style="margin: 0; font-size: 14px; color: rgba(244,238,223,.7)">[partnerships@email]</p>}
</div>
</section>

<Join />
</Base>
