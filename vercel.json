{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/episode.html", "destination": "/episodes/", "permanent": true },
    { "source": "/:page(episodes|videos|news|guests|partners).html", "destination": "/:page/", "permanent": true },
    { "source": "/episodes/:slug/", "destination": "/episodes/", "permanent": false }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
